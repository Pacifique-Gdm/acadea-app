{
  "name": "acadea",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:staging",
    "dev:staging": "node scripts/devStaging.cjs",
    "dev:vite": "vite --mode staging --host 127.0.0.1",
    "dev:production": "vite --mode production --host 127.0.0.1",
    "build": "npm run build:production",
    "build:staging": "node scripts/verifyDeploymentEnvironment.cjs staging && tsc -b && vite build --mode staging",
    "build:production": "node scripts/verifyProductionBranch.cjs production && node scripts/verifyDeploymentEnvironment.cjs production && tsc -b && vite build --mode production",
    "deploy:vercel:production": "node scripts/deployVercelProduction.cjs",
    "verify:vercel:staging": "node scripts/verifyVercelProject.cjs staging",
    "verify:vercel:production": "node scripts/verifyVercelProject.cjs production && node scripts/verifyProductionBranch.cjs production",
    "deployment:plan": "node scripts/deploymentPlan.cjs",
    "test:pipeline": "node --test scripts/pipeline.test.cjs",
    "build:vercel": "node scripts/buildVercelEnvironment.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:firestore": "vitest run --config vitest.firestore.config.ts",
    "test:storage": "vitest run --config vitest.storage.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:staging": "playwright test",
    "claims:set": "node scripts/setCustomClaims.cjs",
    "options:reconcile": "tsx scripts/reconcileSchoolOptions.ts",
    "import:firestore": "echo Firestore import must use real Firebase exports only.",
    "reset:staging": "echo Staging reset from demo data has been removed."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "firebase": "12.17.1",
    "firebase-admin": "14.2.0",
    "jspdf": "4.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "overrides": {
    "jwks-rsa": "3.2.0",
    "tar": "7.5.21",
    "js-yaml": "4.3.1",
    "brace-expansion@<1.1.18": "1.1.18",
    "@vercel/python-analysis": {
      "minimatch": "10.2.6",
      "smol-toml": "1.6.1"
    },
    "@vercel/backends": {
      "tsx": "4.22.4",
      "path-to-regexp": "8.4.0"
    },
    "@vercel/node": {
      "undici": "5.29.0",
      "path-to-regexp": "6.3.0"
    },
    "vercel": {
      "path-to-regexp@>=6.0.0 <6.3.0": "6.3.0",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "smol-toml": "1.6.1",
      "@tootallnate/once": "2.0.1",
      "@vercel/static-config": {
        "ajv": "8.18.0"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^16.4.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.0",
    "vercel": "^58.8.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.10"
  }
}
