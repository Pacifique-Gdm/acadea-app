rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role == "admin"
        ? "school_admin"
        : request.auth.token.role;
    }

    function tenantSchoolId() {
      return request.auth.token.schoolId;
    }

    function tenantParentId() {
      return request.auth.token.parentId;
    }

    function tenantSchoolNotDeleting() {
      return !exists(/databases/$(database)/documents/schools/$(tenantSchoolId()))
        || get(/databases/$(database)/documents/schools/$(tenantSchoolId())).data.status != "deleting";
    }

    function superAdmin() {
      return signedIn() && role() == "super_admin";
    }

    function billingControlsShape() {
      return request.resource.data.keys().hasOnly(["valvesUploadsEnabled", "reason", "updatedAt", "updatedBy"])
        && request.resource.data.valvesUploadsEnabled is bool
        && request.resource.data.updatedAt is string
        && (!("reason" in request.resource.data) || request.resource.data.reason is string)
        && (!("updatedBy" in request.resource.data) || request.resource.data.updatedBy is string);
    }

    function schoolUser() {
      return signedIn()
        && role() in ["school_admin", "cashier", "secretary", "parent"]
        && tenantSchoolId() is string;
    }

    function schoolAdmin() {
      return signedIn() && role() == "school_admin" && tenantSchoolId() is string;
    }

    function parentUser() {
      return signedIn()
        && role() == "parent"
        && tenantSchoolId() is string
        && tenantParentId() is string;
    }

    function secretary() {
      return signedIn() && role() == "secretary" && tenantSchoolId() is string;
    }

    function activeCashier() {
      return signedIn()
        && role() == "cashier"
        && tenantSchoolId() is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == tenantSchoolId()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "cashier"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "inactive"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false;
    }

    function studyDirector() {
      return signedIn() && role() == "study_director" && tenantSchoolId() is string;
    }

    function studyDirectorSectionAllowed(section) {
      return studyDirector()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == tenantSchoolId()
        && (((!("sectionIds" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
                || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sectionIds.size() == 0)
              && (!("section" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
                || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.section == null))
          || (("sectionIds" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
              && section in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sectionIds)
          || (("section" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
              && section == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.section));
    }

    function studyDirectorHasNoSectionScope() {
      return studyDirector()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == tenantSchoolId()
        && (!("sectionIds" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sectionIds.size() == 0)
        && (!("section" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.section == null);
    }

    function activeTeacher() {
      return signedIn()
        && role() == "teacher"
        && tenantSchoolId() is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == tenantSchoolId()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "inactive"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false;
    }

    function teacherTenantResource() {
      return activeTeacher() && resource.data.schoolId == tenantSchoolId();
    }

    function teacherOwnProfile() {
      return teacherTenantResource()
        && resource.data.userId == request.auth.uid;
    }

    function teacherOwnAssignment() {
      return teacherTenantResource()
        && exists(/databases/$(database)/documents/teachers/$(resource.data.teacherId))
        && get(/databases/$(database)/documents/teachers/$(resource.data.teacherId)).data.schoolId == tenantSchoolId()
        && get(/databases/$(database)/documents/teachers/$(resource.data.teacherId)).data.userId == request.auth.uid;
    }

    function studyTenantResource() {
      return studyDirector() && resource.data.schoolId == tenantSchoolId();
    }

    function publishedScheduleReader() {
      return signedIn()
        && role() in ["school_admin", "secretary", "discipline_director"]
        && tenantSchoolId() is string;
    }

    function activeStudyYearCreate() {
      return studyDirector()
        && tenantSchoolNotDeleting()
        && request.resource.data.schoolId == tenantSchoolId()
        && activeSchoolYearBelongsToSchool(request.resource.data.schoolYearId, tenantSchoolId());
    }

    function activeStudyYearUpdate() {
      return studyTenantResource()
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.schoolYearId == resource.data.schoolYearId
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId());
    }

    function validValveAttachment(attachment, valveId) {
      return attachment is map
        && attachment.keys().hasOnly(["name", "type", "url", "path", "size"])
        && attachment.name is string
        && attachment.name.size() > 0
        && attachment.type in ["application/pdf", "image/jpeg", "image/png", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
        && attachment.size is int
        && attachment.size > 0
        && attachment.size <= 10 * 1024 * 1024
        && attachment.path is string
        && attachment.path.matches("^valves/" + tenantSchoolId() + "/" + request.resource.data.schoolYearId + "/" + valveId + "/[0-9a-fA-F-]+\\.(pdf|jpg|jpeg|png|docx)$")
        && attachment.url is string
        && (attachment.url.matches("^https://firebasestorage\\.googleapis\\.com/v0/b/[^/]+/o/valves%2F" + tenantSchoolId() + "%2F" + request.resource.data.schoolYearId + "%2F" + valveId + "%2F[^/?]+\\?[^#]+$")
          || attachment.url.matches("^https://storage\\.googleapis\\.com/[^/]+/valves/" + tenantSchoolId() + "/" + request.resource.data.schoolYearId + "/" + valveId + "/[^/?]+$"));
    }

    function validValveAttachments(valveId) {
      return !("attachments" in request.resource.data)
        || (request.resource.data.attachments is list
          && request.resource.data.attachments.size() <= 5
          && (request.resource.data.attachments.size() < 1 || validValveAttachment(request.resource.data.attachments[0], valveId))
          && (request.resource.data.attachments.size() < 2 || validValveAttachment(request.resource.data.attachments[1], valveId))
          && (request.resource.data.attachments.size() < 3 || validValveAttachment(request.resource.data.attachments[2], valveId))
          && (request.resource.data.attachments.size() < 4 || validValveAttachment(request.resource.data.attachments[3], valveId))
          && (request.resource.data.attachments.size() < 5 || validValveAttachment(request.resource.data.attachments[4], valveId)));
    }

    function validValveAttachmentWrite(valveId) {
      return !request.resource.data.keys().hasAny(["attachmentDataUrl", "attachmentUrl", "attachmentPath"])
        && validValveAttachments(valveId);
    }

    function medicalRecordUser() {
      return signedIn()
        && role() in ["school_admin", "secretary"]
        && tenantSchoolId() is string;
    }

    function medicalRecordStudentInTenant(studentId) {
      return exists(/databases/$(database)/documents/students/$(studentId))
        && get(/databases/$(database)/documents/students/$(studentId)).data.schoolId == tenantSchoolId();
    }

    function medicalRecordStudentInYear(studentId, schoolYearId) {
      return medicalRecordStudentInTenant(studentId)
        && get(/databases/$(database)/documents/students/$(studentId)).data.schoolYearId == schoolYearId;
    }

    function medicalRecordReadInTenant(studentId) {
      return resource == null
        ? medicalRecordStudentInTenant(studentId)
        : resource.data.schoolId == tenantSchoolId();
    }

    function parentLinkedMedicalRecordStudent(studentId) {
      return parentUser()
        && medicalRecordStudentInTenant(studentId)
        && get(/databases/$(database)/documents/students/$(studentId)).data.parentId == tenantParentId();
    }

    function parentMedicalRecordRead(studentId) {
      return parentLinkedMedicalRecordStudent(studentId)
        && (resource == null
          || (resource.data.schoolId == tenantSchoolId()
            && resource.data.studentId == studentId
            && resource.data.schoolYearId == get(/databases/$(database)/documents/students/$(studentId)).data.schoolYearId));
    }

    function secretaryStudentCreate() {
      return secretary()
        && activeTenantYearCreate()
        && request.resource.data.status == "ACTIVE";
    }

    function secretaryStudentUpdate() {
      return secretary()
        && activeTenantYearUpdate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "nom", "postnom", "prenom", "sexe", "birthDate", "address", "phone",
          "className", "classId", "subClassId", "classOptionKey", "section", "option", "photoUrl", "parentId", "updatedAt"
        ]);
    }

    function secretaryParentLinkUpdate() {
      return secretary()
        && activeTenantYearUpdate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["studentIds", "updatedAt"]);
    }

    function secretaryParentWrite() {
      return secretary()
        && activeTenantYearUpdate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "fullName", "phone", "email", "address", "studentIds", "status", "updatedAt"
        ]);
    }

    function secretarySchoolOptionsUpdate(schoolId) {
      return secretary()
        && schoolId == tenantSchoolId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["schoolOptions"]);
    }

    function secretarySchoolYearImportUpdate() {
      return secretary()
        && sameTenantUpdate()
        && sameYearUpdate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "studentsImportedFromArchivedYear", "studentsImportedFromYearId", "studentsImportedAt"
        ]);
    }

    function disciplineDirector() {
      return signedIn()
        && role() == "discipline_director"
        && tenantSchoolId() is string;
    }

    function sameTenantResource() {
      return schoolUser() && resource.data.schoolId == tenantSchoolId();
    }

    function sameTenantCreate() {
      return schoolUser()
        && tenantSchoolNotDeleting()
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId == tenantSchoolId();
    }

    function disciplineTenantResource() {
      return disciplineDirector() && resource.data.schoolId == tenantSchoolId();
    }

    function disciplineTenantCreate() {
      return disciplineDirector()
        && tenantSchoolNotDeleting()
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId == tenantSchoolId();
    }

    function sameTenantUpdate() {
      return sameTenantResource()
        && request.resource.data.schoolId == resource.data.schoolId;
    }

    function sameYearUpdate() {
      return !("schoolYearId" in resource.data)
        || request.resource.data.schoolYearId == resource.data.schoolYearId;
    }

    function schoolYearBelongsToSchool(schoolYearId, schoolId) {
      return schoolYearId is string
        && schoolYearId.size() > 0
        && exists(/databases/$(database)/documents/schoolYears/$(schoolYearId))
        && get(/databases/$(database)/documents/schoolYears/$(schoolYearId)).data.schoolId == schoolId;
    }

    function activeSchoolYearBelongsToSchool(schoolYearId, schoolId) {
      return schoolYearBelongsToSchool(schoolYearId, schoolId)
        && get(/databases/$(database)/documents/schoolYears/$(schoolYearId)).data.status == "active";
    }

    function activeTenantYearCreate() {
      return sameTenantCreate()
        && activeSchoolYearBelongsToSchool(request.resource.data.schoolYearId, tenantSchoolId());
    }

    function activeTenantYearUpdate() {
      return sameTenantUpdate()
        && sameYearUpdate()
        && activeSchoolYearBelongsToSchool(request.resource.data.schoolYearId, tenantSchoolId());
    }

    function activeDisciplineYearCreate() {
      return disciplineTenantCreate()
        && activeSchoolYearBelongsToSchool(request.resource.data.schoolYearId, tenantSchoolId());
    }

    function activeDisciplineYearUpdate() {
      return disciplineTenantResource()
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.schoolYearId == resource.data.schoolYearId
        && activeSchoolYearBelongsToSchool(request.resource.data.schoolYearId, tenantSchoolId());
    }

    function schoolSettingsUpdate(schoolId) {
      return schoolAdmin()
        && schoolId == tenantSchoolId()
        && request.resource.data.id == resource.data.id
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["aiAssistant"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "motto",
          "address",
          "phone",
          "email",
          "logoUrl",
          "acronym",
          "educationLevels",
          "schoolOptions",
          "schoolType",
          "activeSchoolYearId",
          "updatedAt",
          "updatedBy"
        ]);
    }

    function superAdminAiAssistantUpdate() {
      return superAdmin()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["aiAssistant"])
          || (request.resource.data.aiAssistant is map
            && request.resource.data.aiAssistant.keys().hasOnly(["enabled", "monthlyLimit", "monthlyUsage", "usageMonth", "updatedAt", "updatedBy"])
            && (!("enabled" in request.resource.data.aiAssistant) || request.resource.data.aiAssistant.enabled is bool)
            && (!("monthlyLimit" in request.resource.data.aiAssistant)
              || (request.resource.data.aiAssistant.monthlyLimit is int
                && request.resource.data.aiAssistant.monthlyLimit >= 1
                && request.resource.data.aiAssistant.monthlyLimit <= 1000))
            && (!("monthlyUsage" in request.resource.data.aiAssistant)
              || (request.resource.data.aiAssistant.monthlyUsage is int
                && request.resource.data.aiAssistant.monthlyUsage >= 0))
            && (!("usageMonth" in request.resource.data.aiAssistant)
              || request.resource.data.aiAssistant.usageMonth is string)
            && request.resource.data.aiAssistant.updatedBy == request.auth.uid
            && request.resource.data.aiAssistant.updatedAt is timestamp
            && ((!("aiAssistant" in resource.data) && !("monthlyUsage" in request.resource.data.aiAssistant))
              || ("aiAssistant" in resource.data
                && request.resource.data.aiAssistant.monthlyUsage == resource.data.aiAssistant.monthlyUsage))
            && ((!("aiAssistant" in resource.data) && !("usageMonth" in request.resource.data.aiAssistant))
              || ("aiAssistant" in resource.data
                && request.resource.data.aiAssistant.usageMonth == resource.data.aiAssistant.usageMonth))));
    }

    function publicAppConfigShape() {
      return request.resource.data.keys().hasOnly(["loginLogoUrl", "updatedAt"])
        && (!("loginLogoUrl" in request.resource.data) || request.resource.data.loginLogoUrl is string)
        && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is string);
    }

    match /publicConfig/appConfig {
      allow read: if true;
      allow create, update: if superAdmin() && publicAppConfigShape();
      allow delete: if false;
    }

    // Document historique : jamais public. Les deux champs autorisés sont
    // désormais isolés dans publicConfig/appConfig.
    match /platform/appConfig {
      allow read: if superAdmin();
      allow write: if false;
    }

    match /platform/{document=**} {
      allow read: if superAdmin();
      allow write: if false;
    }

    match /platformSettings/billingControls {
      allow read: if signedIn();
      allow create, update: if superAdmin() && billingControlsShape();
      allow delete: if false;
    }

    match /schools/{schoolId} {
      allow read: if superAdmin() || (schoolUser() && schoolId == tenantSchoolId()) || (disciplineDirector() && schoolId == tenantSchoolId()) || (studyDirector() && schoolId == tenantSchoolId()) || (activeTeacher() && schoolId == tenantSchoolId());
      allow create: if superAdmin();
      allow update: if superAdminAiAssistantUpdate() || schoolSettingsUpdate(schoolId) || secretarySchoolOptionsUpdate(schoolId);
      allow delete: if superAdmin();
    }

    match /schools/{schoolId}/aiUsageReservations/{reservationId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if superAdmin()
        || (signedIn() && request.auth.uid == userId)
        || (schoolAdmin()
          && resource.data.schoolId == tenantSchoolId()
          && resource.data.role in ["school_admin", "cashier", "discipline_director", "study_director", "secretary", "teacher"])
        || (studyDirector()
          && resource.data.schoolId == tenantSchoolId()
          && resource.data.role == "teacher");
      allow create: if (superAdmin()
          && request.resource.data.id == userId
          && request.resource.data.role == "school_admin"
          && request.resource.data.schoolId is string)
        || (schoolAdmin()
          && request.resource.data.id == userId
          && request.resource.data.role == "parent"
          && request.resource.data.schoolId == tenantSchoolId()
          && request.resource.data.parentId is string);
      allow update: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["id", "role", "schoolId", "parentId", "studentIds", "status", "active", "archivedAt", "archivedBy", "reactivatedAt", "reactivatedBy"]);
      allow delete: if false;

      match /pushTokens/{tokenId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == userId
          && request.resource.data.deviceId == tokenId
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform == "web"
          && request.resource.data.active is bool
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string
          && request.resource.data.keys().hasOnly([
            "userId",
            "deviceId",
            "token",
            "platform",
            "active",
            "createdAt",
            "updatedAt"
          ]);
      }
    }

    match /schoolYears/{yearId} {
      allow read: if superAdmin() || sameTenantResource() || disciplineTenantResource() || (studyDirector() && resource.data.schoolId == tenantSchoolId()) || teacherTenantResource();
      allow create: if schoolAdmin() && sameTenantCreate();
      allow update: if schoolAdmin() && sameTenantUpdate() && sameYearUpdate();
      allow delete: if false;
    }

    function validStudentClassReferences() {
      return (!("classId" in request.resource.data) || request.resource.data.classId == null
          || (request.resource.data.classId is string
            && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.schoolId == tenantSchoolId()
            && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.schoolYearId == request.resource.data.schoolYearId
            && !("parentClassId" in get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data)))
        && (!("subClassId" in request.resource.data) || request.resource.data.subClassId == null
          || (request.resource.data.subClassId is string
            && get(/databases/$(database)/documents/classes/$(request.resource.data.subClassId)).data.schoolId == tenantSchoolId()
            && get(/databases/$(database)/documents/classes/$(request.resource.data.subClassId)).data.schoolYearId == request.resource.data.schoolYearId
            && get(/databases/$(database)/documents/classes/$(request.resource.data.subClassId)).data.parentClassId == request.resource.data.classId
            && (!("classOptionKey" in get(/databases/$(database)/documents/classes/$(request.resource.data.subClassId)).data)
              || (("classOptionKey" in request.resource.data)
                && request.resource.data.classOptionKey == get(/databases/$(database)/documents/classes/$(request.resource.data.subClassId)).data.classOptionKey))));
    }

    match /students/{studentId} {
      allow read: if superAdmin()
        || (role() in ["school_admin", "cashier", "secretary"] && sameTenantResource())
        || (studyTenantResource() && (studyDirectorHasNoSectionScope() || (("section" in resource.data) && studyDirectorSectionAllowed(resource.data.section))))
        || disciplineTenantResource()
        || (parentUser() && resource.data.schoolId == tenantSchoolId() && resource.data.parentId == tenantParentId());
      allow create: if schoolAdmin() && activeTenantYearCreate() && validStudentClassReferences();
      allow update: if schoolAdmin() && activeTenantYearUpdate() && validStudentClassReferences();
      allow delete: if false;
    }

    match /parents/{parentId} {
      allow read: if superAdmin()
        || (role() in ["school_admin", "cashier", "secretary"] && sameTenantResource())
        || disciplineTenantResource()
        || (parentUser() && resource.data.schoolId == tenantSchoolId() && parentId == tenantParentId());
      allow create: if schoolAdmin() && activeTenantYearCreate();
      allow update: if schoolAdmin() && activeTenantYearUpdate();
      allow delete: if schoolAdmin() && sameTenantResource()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId());
    }

    match /payments/{paymentId} {
      allow read: if superAdmin()
        || (role() in ["school_admin", "cashier", "secretary"] && sameTenantResource())
        || (parentUser() && resource.data.schoolId == tenantSchoolId() && resource.data.parentId == tenantParentId());
      // Financial mutations are performed exclusively by the authenticated
      // server endpoint using Firebase Admin and an atomic transaction.
      allow create, update, delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if superAdmin() || role() in ["school_admin", "cashier"] && sameTenantResource();
      allow create, update, delete: if false;
    }

    match /financialCounters/{counterId} {
      allow read, write: if false;
    }

    match /financialIdempotency/{requestId} {
      allow read, write: if false;
    }

    match /auditLogs/{auditLogId} {
      allow read: if superAdmin()
        || schoolAdmin() && sameTenantResource()
        || secretary() && sameTenantResource() && resource.data.actorId == request.auth.uid
        || activeCashier() && sameTenantResource() && resource.data.actorId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /schoolYears/{yearId} {
      allow update: if secretarySchoolYearImportUpdate();
    }

    match /disciplineSanctions/{sanctionId} {
      allow read: if superAdmin()
        || (schoolAdmin() && sameTenantResource())
        || disciplineTenantResource();
      allow create: if activeDisciplineYearCreate()
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.size() > 0
        && request.resource.data.schoolYearId is string
        && request.resource.data.schoolYearId.size() > 0
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.className is string
        && request.resource.data.className.size() > 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.sanctionType is string
        && request.resource.data.sanctionType.size() > 0
        && (request.resource.data.duration is int || request.resource.data.duration is float)
        && request.resource.data.duration > 0
        && request.resource.data.startDate is string
        && request.resource.data.startDate.size() > 0
        && request.resource.data.expectedEndDate is string
        && request.resource.data.expectedEndDate.size() > 0
        && request.resource.data.status == "active"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() > 0
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() > 0;
      allow update: if activeDisciplineYearUpdate()
        && resource.data.status == "active"
        && request.resource.data.status == "completed"
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.schoolYearId == resource.data.schoolYearId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.completedBy == request.auth.uid
        && request.resource.data.completedBy is string;
      allow delete: if false;
    }

    match /feeTypes/{feeTypeId} {
      allow read: if superAdmin() || sameTenantResource();
      allow create: if schoolAdmin() && activeTenantYearCreate();
      allow update: if schoolAdmin() && activeTenantYearUpdate();
      allow delete: if schoolAdmin() && sameTenantResource()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId());
    }

    match /teachers/{teacherId} {
      allow read: if superAdmin() || sameTenantResource() || studyTenantResource() || teacherOwnProfile();
      allow create: if schoolAdmin() && activeTenantYearCreate();
      allow update: if schoolAdmin() && activeTenantYearUpdate();
      allow delete: if schoolAdmin() && sameTenantResource()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId());
    }

    match /classes/{classId} {
      function validSubclassCreate() {
        return secretary()
          && activeTenantYearCreate()
          && request.resource.data.parentClassId is string
          && request.resource.data.subClassLabel is string
          && request.resource.data.subClassLabel.size() > 0
          && (!("classOptionKey" in request.resource.data)
            || (request.resource.data.classOptionKey is string
              && request.resource.data.classOptionKey.matches("^" + request.resource.data.parentClassId + "::.+$")))
          && existsAfter(/databases/$(database)/documents/classes/$(request.resource.data.parentClassId))
          && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.parentClassId)).data.schoolId == tenantSchoolId()
          && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.parentClassId)).data.schoolYearId == request.resource.data.schoolYearId
          && !("parentClassId" in getAfter(/databases/$(database)/documents/classes/$(request.resource.data.parentClassId)).data)
          && request.resource.data.createdBy == request.auth.uid;
      }
      function validSecretaryBaseClassCreate() {
        return secretary()
          && activeTenantYearCreate()
          && !("parentClassId" in request.resource.data)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly(["id", "schoolId", "schoolYearId", "name", "active", "createdBy", "createdAt", "updatedAt"]);
      }
      function validStudyLegacyClassCreate() {
        return studyDirector()
          && activeStudyYearCreate()
          && classId.matches("^" + tenantSchoolId() + "__" + request.resource.data.schoolYearId + "__.+$")
          && !("parentClassId" in request.resource.data)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly(["id", "schoolId", "schoolYearId", "name", "active", "createdBy", "createdAt", "updatedAt"]);
      }
      allow read: if superAdmin() || sameTenantResource() || studyTenantResource() || teacherTenantResource();
      allow create: if (schoolAdmin() && activeTenantYearCreate()) || validSubclassCreate() || validSecretaryBaseClassCreate() || validStudyLegacyClassCreate();
      allow update: if (schoolAdmin() && activeTenantYearUpdate())
        || (activeStudyYearUpdate()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["vacation", "saturdayVacation", "saturdayEnabled", "updatedAt"])
          && request.resource.data.vacation in ["morning", "afternoon"]
          && request.resource.data.saturdayEnabled is bool
          && (request.resource.data.saturdayVacation == null || request.resource.data.saturdayVacation in ["morning", "afternoon"]));
      allow delete: if schoolAdmin() && sameTenantResource()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId());
    }

    match /subjects/{subjectId} {
      allow read: if superAdmin() || studyTenantResource() || teacherTenantResource();
      allow create: if activeStudyYearCreate()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.active is bool
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      allow update: if activeStudyYearUpdate()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "active", "updatedAt"]);
      allow delete: if false;
    }

    match /pedagogicalAssignments/{assignmentId} {
      function assignmentTeacherIsActive() {
        let teacher = get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data;
        return teacher.status != "inactive"
          && (!("userId" in teacher)
            || (teacher.userId is string
              && exists(/databases/$(database)/documents/users/$(teacher.userId))
              && get(/databases/$(database)/documents/users/$(teacher.userId)).data.schoolId == tenantSchoolId()
              && get(/databases/$(database)/documents/users/$(teacher.userId)).data.role == "teacher"
              && get(/databases/$(database)/documents/users/$(teacher.userId)).data.status != "inactive"
              && get(/databases/$(database)/documents/users/$(teacher.userId)).data.active != false));
      }
      function assignmentReferencesAreValid() {
        return get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.schoolId == tenantSchoolId()
          && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.schoolYearId == request.resource.data.schoolYearId
          && assignmentTeacherIsActive()
          && get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.schoolId == tenantSchoolId()
          && get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.schoolYearId == request.resource.data.schoolYearId
          && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.schoolId == tenantSchoolId()
          && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.schoolYearId == request.resource.data.schoolYearId
          && (!("titularClassId" in request.resource.data) || request.resource.data.titularClassId == null
            || (request.resource.data.titularClassId is string
              && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.titularClassId)).data.schoolId == tenantSchoolId()
              && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.titularClassId)).data.schoolYearId == request.resource.data.schoolYearId
              && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.titularClassId)).data.active != false))
          && (!("preferredRoomId" in request.resource.data) || request.resource.data.preferredRoomId == null
            || (request.resource.data.preferredRoomId is string
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.preferredRoomId)).data.schoolId == tenantSchoolId()
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.preferredRoomId)).data.schoolYearId == request.resource.data.schoolYearId
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.preferredRoomId)).data.active == true));
      }
      function validAssignmentShape() {
        return request.resource.data.id == assignmentId
          && assignmentId == request.resource.data.schoolId + "__" + request.resource.data.schoolYearId + "__" + request.resource.data.teacherId + "__" + request.resource.data.subjectId + "__" + request.resource.data.classId
          && request.resource.data.weeklyPeriods is int
          && request.resource.data.weeklyPeriods > 0
          && request.resource.data.weeklyPeriods <= 60
          && (!("blockSize" in request.resource.data) || request.resource.data.blockSize in [1, 2])
          && request.resource.data.active is bool
          && request.resource.data.createdBy is string
          && request.resource.data.updatedBy is string
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;
      }
      allow read: if superAdmin() || studyTenantResource() || teacherOwnAssignment();
      allow create: if activeStudyYearCreate()
        && validAssignmentShape()
        && assignmentReferencesAreValid()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if activeStudyYearUpdate()
        && validAssignmentShape()
        && assignmentReferencesAreValid()
        && request.resource.data.id == resource.data.id
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.subjectId == resource.data.subjectId
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /classTitulars/{titularId} {
      function validTitularShape() {
        return request.resource.data.id == titularId
          && titularId == request.resource.data.schoolId + "__" + request.resource.data.schoolYearId + "__" + request.resource.data.classId
          && request.resource.data.schoolId == tenantSchoolId()
          && activeSchoolYearBelongsToSchool(request.resource.data.schoolYearId, tenantSchoolId())
          && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.schoolId == tenantSchoolId()
          && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.schoolYearId == request.resource.data.schoolYearId
          && getAfter(/databases/$(database)/documents/pedagogicalAssignments/$(request.resource.data.assignmentId)).data.schoolId == tenantSchoolId()
          && getAfter(/databases/$(database)/documents/pedagogicalAssignments/$(request.resource.data.assignmentId)).data.teacherId == request.resource.data.teacherId
          && request.resource.data.updatedBy == request.auth.uid;
      }
      allow get: if studyDirector() && (!exists(/databases/$(database)/documents/classTitulars/$(titularId)) || sameTenantResource());
      allow list: if studyTenantResource();
      allow create, update: if studyDirector() && validTitularShape();
      allow delete: if studyDirector() && sameTenantResource();
    }

    // Cotations are mediated by the authenticated server endpoint, which verifies
    // the assignment, teacher profile, student class and titular read scope.
    match /courseGradingConfigs/{configId} {
      allow read, create, update, delete: if false;
    }

    match /gradeEntries/{entryId} {
      allow read, create, update, delete: if false;
    }

    match /teacherAvailabilities/{availabilityId} {
      allow read: if superAdmin() || studyTenantResource();
      allow create: if activeStudyYearCreate() && request.resource.data.teacherId is string && request.resource.data.dayOfWeek in ["monday","tuesday","wednesday","thursday","friday","saturday"] && request.resource.data.status in ["available","unavailable","rest"] && request.resource.data.active is bool && request.resource.data.createdBy == request.auth.uid && exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)) && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.schoolId == tenantSchoolId() && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.schoolYearId == request.resource.data.schoolYearId;
      allow update: if activeStudyYearUpdate() && request.resource.data.teacherId == resource.data.teacherId && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /teacherAvailabilityRequests/{requestId} {
      function ownTeacherRequest() {
        return activeTeacher()
          && resource.data.schoolId == tenantSchoolId()
          && resource.data.userId == request.auth.uid
          && exists(/databases/$(database)/documents/teachers/$(resource.data.teacherId))
          && get(/databases/$(database)/documents/teachers/$(resource.data.teacherId)).data.userId == request.auth.uid;
      }
      function validTeacherRequestCreate() {
        return activeTeacher()
          && request.resource.data.keys().hasOnly(["id", "schoolId", "schoolYearId", "teacherId", "userId", "requestedDate", "requestType", "startTime", "endTime", "reason", "status", "createdAt", "createdBy"])
          && request.resource.data.id == requestId
          && request.resource.data.schoolId == tenantSchoolId()
          && activeSchoolYearBelongsToSchool(request.resource.data.schoolYearId, tenantSchoolId())
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == "PENDING"
          && request.resource.data.requestType in ["FULL_DAY", "TIME_RANGE"]
          && request.resource.data.requestedDate is string
          && request.resource.data.requestedDate.size() == 10
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 1000
          && request.resource.data.createdAt is string
          && exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId))
          && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.schoolId == tenantSchoolId()
          && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.schoolYearId == request.resource.data.schoolYearId
          && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.status != "inactive"
          && ((request.resource.data.requestType == "FULL_DAY" && !request.resource.data.keys().hasAny(["startTime", "endTime"]))
            || (request.resource.data.requestType == "TIME_RANGE"
              && request.resource.data.startTime is string
              && request.resource.data.endTime is string
              && request.resource.data.startTime < request.resource.data.endTime));
      }
      allow read: if superAdmin() || studyTenantResource() || ownTeacherRequest();
      allow create: if validTeacherRequestCreate();
      allow update, delete: if false;
    }

    match /schedulePeriods/{periodId} {
      allow read: if superAdmin() || studyTenantResource() || teacherTenantResource();
      allow create: if activeStudyYearCreate() && request.resource.data.label is string && request.resource.data.startTime is string && request.resource.data.endTime is string && request.resource.data.startTime < request.resource.data.endTime && request.resource.data.order is int && request.resource.data.order > 0 && request.resource.data.type in ["course","break","recess"] && (!request.resource.data.keys().hasAny(["vacation"]) || request.resource.data.vacation in ["morning","afternoon"]) && (!request.resource.data.keys().hasAny(["dayScope"]) || request.resource.data.dayScope in ["weekdays","saturday"]) && request.resource.data.active is bool && request.resource.data.createdBy == request.auth.uid;
      allow update: if activeStudyYearUpdate() && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /timetables/{scheduleId} {
      function validTimetableShape() {
        return request.resource.data.id == scheduleId
          && request.resource.data.version is int
          && request.resource.data.version > 0
          && request.resource.data.status in ["DRAFT", "VALID", "PUBLISHED"]
          && request.resource.data.activeDraft is bool
          && request.resource.data.createdBy is string
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string;
      }
      allow read: if superAdmin() || studyTenantResource()
        || (publishedScheduleReader() && resource.data.schoolId == tenantSchoolId() && resource.data.status == "PUBLISHED" && resource.data.activePublished == true)
        || (teacherTenantResource() && resource.data.status == "PUBLISHED" && resource.data.activePublished == true);
      allow create: if activeStudyYearCreate()
        && validTimetableShape()
        && request.resource.data.status == "DRAFT"
        && request.resource.data.activeDraft == true
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if activeStudyYearUpdate()
        && validTimetableShape()
        && request.resource.data.id == resource.data.id
        && request.resource.data.version == resource.data.version
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && ((resource.data.status == "DRAFT" && request.resource.data.status == "DRAFT"
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeDraft", "updatedAt"]))
          || (resource.data.status == "DRAFT" && request.resource.data.status == "VALID"
             && request.resource.data.activeDraft == false
             && request.resource.data.validatedBy == request.auth.uid
             && request.resource.data.validatedAt is string
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "activeDraft", "validatedBy", "validatedAt", "updatedAt"]))
          || (resource.data.status == "VALID" && request.resource.data.status == "PUBLISHED"
             && request.resource.data.activePublished == true
             && request.resource.data.publishedBy == request.auth.uid
             && request.resource.data.publishedAt is string
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "activePublished", "activeDraft", "publishedBy", "publishedAt", "updatedAt"]))
          || (resource.data.status == "PUBLISHED" && request.resource.data.status == "PUBLISHED"
             && resource.data.activePublished == true && request.resource.data.activePublished == false
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activePublished", "updatedAt"])));
      allow delete: if false;
    }

    match /timetableEntries/{entryId} {
      function entryReferencesAreValid() {
        return existsAfter(/databases/$(database)/documents/timetables/$(request.resource.data.scheduleId))
          && getAfter(/databases/$(database)/documents/timetables/$(request.resource.data.scheduleId)).data.schoolId == request.resource.data.schoolId
          && getAfter(/databases/$(database)/documents/timetables/$(request.resource.data.scheduleId)).data.schoolYearId == request.resource.data.schoolYearId
          && getAfter(/databases/$(database)/documents/timetables/$(request.resource.data.scheduleId)).data.status == "DRAFT"
          && exists(/databases/$(database)/documents/pedagogicalAssignments/$(request.resource.data.assignmentId))
          && get(/databases/$(database)/documents/pedagogicalAssignments/$(request.resource.data.assignmentId)).data.schoolId == request.resource.data.schoolId
          && get(/databases/$(database)/documents/pedagogicalAssignments/$(request.resource.data.assignmentId)).data.schoolYearId == request.resource.data.schoolYearId
          && get(/databases/$(database)/documents/pedagogicalAssignments/$(request.resource.data.assignmentId)).data.teacherId == request.resource.data.teacherId
          && get(/databases/$(database)/documents/pedagogicalAssignments/$(request.resource.data.assignmentId)).data.classId == request.resource.data.classId
          && get(/databases/$(database)/documents/pedagogicalAssignments/$(request.resource.data.assignmentId)).data.subjectId == request.resource.data.subjectId
          && exists(/databases/$(database)/documents/schedulePeriods/$(request.resource.data.periodId))
          && get(/databases/$(database)/documents/schedulePeriods/$(request.resource.data.periodId)).data.type == "course"
          && (request.resource.data.roomId == null
            || (exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.schoolId == request.resource.data.schoolId
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.schoolYearId == request.resource.data.schoolYearId
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.active == true));
      }
      allow read: if superAdmin() || studyTenantResource()
        || (publishedScheduleReader() && resource.data.schoolId == tenantSchoolId()
          && exists(/databases/$(database)/documents/timetables/$(resource.data.scheduleId))
          && get(/databases/$(database)/documents/timetables/$(resource.data.scheduleId)).data.status == "PUBLISHED"
          && get(/databases/$(database)/documents/timetables/$(resource.data.scheduleId)).data.activePublished == true)
        || (teacherTenantResource()
          && exists(/databases/$(database)/documents/teachers/$(resource.data.teacherId))
          && get(/databases/$(database)/documents/teachers/$(resource.data.teacherId)).data.userId == request.auth.uid
          && exists(/databases/$(database)/documents/timetables/$(resource.data.scheduleId))
          && get(/databases/$(database)/documents/timetables/$(resource.data.scheduleId)).data.status == "PUBLISHED"
          && get(/databases/$(database)/documents/timetables/$(resource.data.scheduleId)).data.activePublished == true);
      allow create: if activeStudyYearCreate()
        && request.resource.data.id == entryId
        && request.resource.data.dayOfWeek in ["monday","tuesday","wednesday","thursday","friday","saturday"]
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && entryReferencesAreValid();
      allow update: if activeStudyYearUpdate()
        && resource.data.scheduleId == request.resource.data.scheduleId
        && resource.data.createdAt == request.resource.data.createdAt
        && get(/databases/$(database)/documents/timetables/$(resource.data.scheduleId)).data.status == "DRAFT"
        && entryReferencesAreValid();
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if superAdmin() || studyTenantResource()
        || (publishedScheduleReader() && resource.data.schoolId == tenantSchoolId())
        || teacherTenantResource();
      allow create: if activeStudyYearCreate()
        && request.resource.data.id == roomId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.active is bool
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      allow update: if activeStudyYearUpdate()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "active", "updatedAt"]);
      allow delete: if false;
    }

    match /grades/{gradeId} {
      allow read: if superAdmin() || sameTenantResource();
      allow create: if schoolAdmin() && activeTenantYearCreate();
      allow update: if schoolAdmin() && activeTenantYearUpdate();
      allow delete: if schoolAdmin() && sameTenantResource()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId());
    }

    match /attendance/{attendanceId} {
      allow read: if superAdmin()
        || sameTenantResource()
        || disciplineTenantResource();
      allow create: if activeDisciplineYearCreate()
        && request.resource.data.schoolYearId is string
        && exists(/databases/$(database)/documents/schoolYears/$(request.resource.data.schoolYearId))
        && get(/databases/$(database)/documents/schoolYears/$(request.resource.data.schoolYearId)).data.schoolId == tenantSchoolId();
      allow update: if activeDisciplineYearUpdate()
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.schoolYearId == resource.data.schoolYearId
        && exists(/databases/$(database)/documents/schoolYears/$(resource.data.schoolYearId))
        && get(/databases/$(database)/documents/schoolYears/$(resource.data.schoolYearId)).data.schoolId == tenantSchoolId();
      allow delete: if false;
    }

    match /attendanceSettings/{settingsId} {
      allow read: if superAdmin()
        || (schoolAdmin() && sameTenantResource())
        || disciplineTenantResource()
        || studyTenantResource();
      allow create: if activeDisciplineYearCreate();
      allow update: if activeDisciplineYearUpdate();
      allow delete: if false;
    }

    match /biometricTerminals/{terminalId} {
      allow read, create, update: if superAdmin();
      allow delete: if false;
    }

    match /bulletins/{bulletinId} {
      allow read: if superAdmin() || sameTenantResource();
      allow create: if schoolAdmin() && activeTenantYearCreate();
      allow update: if schoolAdmin() && activeTenantYearUpdate();
      allow delete: if schoolAdmin() && sameTenantResource()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId());
    }

    match /documents/{documentId} {
      allow read: if superAdmin() || sameTenantResource();
      allow create: if schoolAdmin() && activeTenantYearCreate();
      allow update: if schoolAdmin() && activeTenantYearUpdate();
      allow delete: if schoolAdmin() && sameTenantResource()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId());
    }

    match /announcements/{announcementId} {
      allow read: if superAdmin() || sameTenantResource();
      allow create: if schoolAdmin() && activeTenantYearCreate();
      allow update: if schoolAdmin() && activeTenantYearUpdate();
      allow delete: if schoolAdmin() && sameTenantResource()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId());
    }

    match /valves/{valveId} {
      allow read: if superAdmin() || sameTenantResource() || disciplineTenantResource();
      allow create: if (schoolAdmin() || secretary()) && activeTenantYearCreate() && validValveAttachmentWrite(valveId);
      allow update: if (schoolAdmin() || secretary()) && activeTenantYearUpdate()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["attachments", "attachmentDataUrl", "attachmentUrl", "attachmentPath"])
          || validValveAttachmentWrite(valveId));
      allow delete: if (schoolAdmin() || secretary()) && sameTenantResource()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId());
    }

    match /messages/{messageId} {
      allow read: if superAdmin()
        || (schoolAdmin() && sameTenantResource()
          && (resource.data.schoolRecipient in ["admin", "both"] || request.auth.uid in resource.data.participantIds))
        || (signedIn() && role() == "cashier" && sameTenantResource()
          && (resource.data.schoolRecipient in ["cashier", "both"] || request.auth.uid in resource.data.participantIds))
        || (secretary() && sameTenantResource()
          && request.auth.uid in resource.data.participantIds)
        || ((activeTeacher() || studyDirector()) && resource.data.schoolId == tenantSchoolId()
          && request.auth.uid in resource.data.participantIds)
        || (disciplineTenantResource()
          && (resource.data.schoolRecipient == "discipline" || request.auth.uid in resource.data.participantIds))
        || (parentUser() && resource.data.schoolId == tenantSchoolId()
          && (resource.data.threadParentId == tenantParentId()
            || (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds)));
      allow create: if !request.resource.data.keys().hasAny(["participantIds", "recipientIds", "attachments"])
        && ((signedIn()
          && role() in ["school_admin", "cashier"]
          && activeTenantYearCreate())
        || (activeDisciplineYearCreate()
          && request.resource.data.schoolRecipient == "discipline"));
      allow update: if schoolAdmin() && activeTenantYearUpdate();
      allow delete: if schoolAdmin() && sameTenantResource()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId());
    }

    match /conversations/{conversationId} {
      allow read: if superAdmin()
        || (schoolAdmin() && sameTenantResource()
          && (resource.data.schoolRecipient in ["admin", "both"] || request.auth.uid in resource.data.participantIds))
        || (signedIn() && role() == "cashier" && sameTenantResource()
          && (resource.data.schoolRecipient in ["cashier", "both"] || request.auth.uid in resource.data.participantIds))
        || (disciplineTenantResource()
          && (resource.data.schoolRecipient == "discipline" || request.auth.uid in resource.data.participantIds))
        || (secretary() && sameTenantResource()
          && request.auth.uid in resource.data.participantIds)
        || ((activeTeacher() || studyDirector()) && resource.data.schoolId == tenantSchoolId()
          && request.auth.uid in resource.data.participantIds)
        || (parentUser() && resource.data.schoolId == tenantSchoolId()
          && (resource.data.parentId == tenantParentId()
            || (resource.data.participantIds is list && request.auth.uid in resource.data.participantIds)));
      allow create: if !request.resource.data.keys().hasAny(["participantIds"])
        && ((schoolAdmin()
          && activeTenantYearCreate()
          && request.resource.data.schoolRecipient == "admin")
        || (signedIn()
          && role() == "cashier"
          && activeTenantYearCreate()
          && request.resource.data.schoolRecipient == "cashier")
        || (activeDisciplineYearCreate()
          && request.resource.data.schoolRecipient == "discipline"));
      allow update: if (schoolAdmin()
          && activeTenantYearUpdate()
          && resource.data.schoolRecipient in ["admin", "both"]
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.schoolYearId == resource.data.schoolYearId
          && request.resource.data.parentId == resource.data.parentId
          && request.resource.data.threadId == resource.data.threadId
          && request.resource.data.threadParentId == resource.data.threadParentId
          && request.resource.data.schoolRecipient == resource.data.schoolRecipient)
        || (signedIn()
          && role() == "cashier"
          && activeTenantYearUpdate()
          && resource.data.schoolRecipient in ["cashier", "both"]
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.schoolYearId == resource.data.schoolYearId
          && request.resource.data.parentId == resource.data.parentId
          && request.resource.data.threadId == resource.data.threadId
          && request.resource.data.threadParentId == resource.data.threadParentId
          && request.resource.data.schoolRecipient == resource.data.schoolRecipient)
        || (disciplineDirector()
          && activeDisciplineYearUpdate()
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.schoolYearId == resource.data.schoolYearId
          && request.resource.data.parentId == resource.data.parentId
          && request.resource.data.threadId == resource.data.threadId
          && request.resource.data.threadParentId == resource.data.threadParentId
          && request.resource.data.schoolRecipient == resource.data.schoolRecipient
          && resource.data.schoolRecipient == "discipline")
        || (parentUser()
          && resource.data.schoolId == tenantSchoolId()
          && resource.data.parentId == tenantParentId()
          && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId())
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.schoolYearId == resource.data.schoolYearId
          && request.resource.data.parentId == resource.data.parentId
          && request.resource.data.threadId == resource.data.threadId
          && request.resource.data.threadParentId == resource.data.threadParentId
          && request.resource.data.schoolRecipient == resource.data.schoolRecipient);
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if superAdmin()
        || (role() in ["school_admin", "cashier"] && sameTenantResource()
          && (resource.data.type != "message" || !("recipientUserId" in resource.data) || resource.data.recipientUserId == request.auth.uid))
        || (secretary() && sameTenantResource()
          && (resource.data.type != "message" || resource.data.recipientUserId == request.auth.uid))
        || ((activeTeacher() || studyDirector()) && resource.data.schoolId == tenantSchoolId()
          && resource.data.recipientUserId == request.auth.uid)
        || (disciplineTenantResource() && resource.data.type == "message" && resource.data.recipientUserId == request.auth.uid)
        || (disciplineTenantResource() && resource.data.recipientRole == "school" && resource.data.schoolRecipient == "discipline")
        || (parentUser() && resource.data.schoolId == tenantSchoolId()
          && (resource.data.parentId == tenantParentId()
            || resource.data.recipientUserId == request.auth.uid));
      allow create: if !request.resource.data.keys().hasAny(["recipientUserId"])
        && signedIn()
        && ((role() in ["school_admin", "cashier", "secretary"] && activeTenantYearCreate())
          || (activeDisciplineYearCreate()
            && ((request.resource.data.recipientRole == "school" && request.resource.data.schoolRecipient == "discipline")
              || (request.resource.data.recipientRole == "parent" && request.resource.data.parentId is string))));
      allow update: if (role() in ["school_admin", "cashier"] && activeTenantYearUpdate())
        || (signedIn()
          && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId())
          && resource.data.schoolId == tenantSchoolId()
          && resource.data.recipientUserId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]))
        || (secretary()
          && activeTenantYearUpdate()
          && resource.data.recipientUserId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]))
        || (disciplineDirector()
          && activeDisciplineYearUpdate()
          && resource.data.schoolRecipient == "discipline"
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.schoolYearId == resource.data.schoolYearId
          && request.resource.data.schoolRecipient == resource.data.schoolRecipient)
        || (parentUser()
        && resource.data.schoolId == tenantSchoolId()
        && resource.data.parentId == tenantParentId()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId())
        && request.resource.data.parentId == resource.data.parentId
        && request.resource.data.schoolId == resource.data.schoolId);
      allow delete: if false;
    }

    match /messageIdempotency/{schoolId}/signals/{signalId} {
      allow get: if disciplineDirector() && schoolId == tenantSchoolId();
      allow list: if false;
      allow create: if disciplineDirector()
        && schoolId == tenantSchoolId()
        && request.resource.data.schoolId == tenantSchoolId()
        && activeSchoolYearBelongsToSchool(request.resource.data.schoolYearId, tenantSchoolId())
        && request.resource.data.sanctionId is string
        && request.resource.data.messageId is string
        && request.resource.data.notificationId is string
        && request.resource.data.createdAt is string
        && request.resource.data.type == "discipline-sanction-signal"
        && request.resource.data.keys().hasOnly([
          "schoolId",
          "schoolYearId",
          "sanctionId",
          "messageId",
          "notificationId",
          "createdAt",
          "type"
        ]);
      allow update, delete: if false;
    }

    match /parentDailyMessageLimits/{limitId} {
      allow get: if parentUser()
        && resource.data.schoolId == tenantSchoolId()
        && resource.data.parentId == tenantParentId();
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Secretary writes are intentionally limited to student administration.
    // The existing school administrator rules above remain unchanged.
    match /students/{studentId} {
      allow create: if secretaryStudentCreate() && validStudentClassReferences();
      allow update: if secretaryStudentUpdate() && validStudentClassReferences();
    }

    match /parents/{parentId} {
      allow create: if secretary() && activeTenantYearCreate();
      allow update: if secretaryParentLinkUpdate() || secretaryParentWrite();
      allow delete: if false;
    }

    match /auditLogs/{auditLogId} {
      allow create, update, delete: if false;
    }

    match /correspondences/{correspondenceId} {
      allow read: if secretary() && sameTenantResource();
      allow create: if secretary()
        && activeTenantYearCreate()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.schoolYearId is string
        && request.resource.data.direction in ["incoming", "outgoing"]
        && (request.resource.data.direction != "outgoing"
          || (request.resource.data.outgoing is map
            && request.resource.data.outgoing.version == 1
            && request.resource.data.outgoing.signer.userId is string
            && request.resource.data.outgoing.recipient is map));
      allow update: if secretary()
        && activeTenantYearUpdate()
        && resource.data.status != "archived"
        && request.resource.data.status != "archived"
        && resource.data.createdBy == request.resource.data.createdBy
        && resource.data.referenceNumber == request.resource.data.referenceNumber
        && resource.data.schoolId == request.resource.data.schoolId
        && resource.data.schoolYearId == request.resource.data.schoolYearId
        && !(resource.data.status == "archived" && request.resource.data.diff(resource.data).affectedKeys().hasAny(["direction", "date", "subject", "sender", "recipient", "content", "copiePourInformation", "attachment"]));
      allow delete: if false;
    }

    match /secretaryCounters/{counterId} {
      allow get: if secretary()
        && (!exists(/databases/$(database)/documents/secretaryCounters/$(counterId))
          || resource.data.schoolId == tenantSchoolId());
      allow list: if false;
      allow create: if secretary()
        && tenantSchoolNotDeleting()
        && request.resource.data.schoolId == tenantSchoolId()
        && activeSchoolYearBelongsToSchool(request.resource.data.schoolYearId, tenantSchoolId())
        && request.resource.data.kind in ["correspondence", "report"]
        && request.resource.data.value == 1;
      allow update: if secretary()
        && tenantSchoolNotDeleting()
        && resource.data.schoolId == tenantSchoolId()
        && activeSchoolYearBelongsToSchool(resource.data.schoolYearId, tenantSchoolId())
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.schoolYearId == resource.data.schoolYearId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.serviceCode == resource.data.serviceCode
        && request.resource.data.year == resource.data.year
        && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    match /studentMedicalRecords/{studentId} {
      allow read: if (medicalRecordUser() && medicalRecordReadInTenant(studentId))
        || parentMedicalRecordRead(studentId);
      allow create: if medicalRecordUser()
        && activeTenantYearCreate()
        && medicalRecordStudentInYear(studentId, request.resource.data.schoolYearId)
        && request.resource.data.id == studentId
        && request.resource.data.studentId == studentId
        && request.resource.data.schoolYearId is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if medicalRecordUser()
        && activeTenantYearUpdate()
        && medicalRecordStudentInYear(studentId, request.resource.data.schoolYearId)
        && resource.data.studentId == studentId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /secretaryReports/{reportId} {
      allow read: if secretary() && sameTenantResource();
      allow create: if secretary()
        && activeTenantYearCreate()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == "draft";
      allow update: if secretary()
        && activeTenantYearUpdate()
        && resource.data.authorId == request.resource.data.authorId
        && resource.data.reportNumber == request.resource.data.reportNumber
        && ((resource.data.status == "draft" && request.resource.data.status == "draft")
          || (resource.data.status == "draft"
            && request.resource.data.status == "finalized"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "finalizedAt", "updatedAt"]))
          );
      allow delete: if false;
    }

    match /aiUsageLogs/{requestId} {
      allow read: if secretary() && resource.data.schoolId == tenantSchoolId() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /_rateLimits/{counterId} {
      allow read, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
