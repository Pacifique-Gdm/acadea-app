rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (!firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.keys().hasAny(["status"])
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status != "inactive")
        && (!firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.keys().hasAny(["active"])
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active != false)
        && ((role() == "super_admin"
            && !firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.keys().hasAny(["role"]))
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role()
          || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin" && role() == "school_admin"))
        && (role() in ["super_admin", "coordination_admin", "sub_coordination_admin"]
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.schoolId == tenantSchoolId())
        && (role() != "parent"
          || (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get("parentId", null) is string
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get("parentId", "").size() > 0
            && (request.auth.token.get("parentId", null) == null
              || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.parentId == request.auth.token.parentId)))
        && (!(role() in ["coordination_admin", "sub_coordination_admin"])
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.coordinationId == request.auth.token.coordinationId)
        && (role() != "sub_coordination_admin"
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.subCoordinationId == request.auth.token.subCoordinationId);
    }

    function role() {
      return request.auth.token.role == "admin" ? "school_admin" : request.auth.token.role;
    }

    function tenantSchoolId() {
      return request.auth.token.schoolId;
    }

    function valvesRole() {
      return role() in ["school_admin", "admin", "secretary"];
    }

    function validPersonnelPhoto(fileName, schoolId, personnelId) {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.metadata.schoolId == schoolId
        && request.resource.metadata.personnelId == personnelId
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp"]
        && fileName.matches('^[0-9a-fA-F-]{36}\\.(jpg|png|webp)$');
    }

    function validMessageObject(fileName, schoolId, schoolYearId) {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.metadata.schoolId == schoolId
        && request.resource.metadata.schoolYearId == schoolYearId
        && request.resource.metadata.originalName is string
        && request.resource.metadata.originalName.size() > 0
        && request.resource.metadata.originalName.size() <= 120
        && (
          (request.resource.contentType == "application/pdf" && fileName.matches('^[0-9a-fA-F-]{36}\\.pdf$'))
          || (request.resource.contentType == "image/jpeg" && fileName.matches('^[0-9a-fA-F-]{36}\\.(jpg|jpeg)$'))
          || (request.resource.contentType == "image/png" && fileName.matches('^[0-9a-fA-F-]{36}\\.png$'))
          || (request.resource.contentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document" && fileName.matches('^[0-9a-fA-F-]{36}\\.docx$'))
        );
    }

    function schoolAcceptsWrites(schoolId) {
      return firestore.exists(/databases/(default)/documents/schools/$(schoolId))
        && firestore.get(/databases/(default)/documents/schools/$(schoolId)).data.status != "suspended"
        && firestore.get(/databases/(default)/documents/schools/$(schoolId)).data.status != "inactive"
        && firestore.get(/databases/(default)/documents/schools/$(schoolId)).data.status != "deleting";
    }

    function studyDirectorManagesTeacher(schoolId, personnelId) {
      return signedIn()
        && role() == "study_director"
        && tenantSchoolId() == schoolId
        && firestore.exists(/databases/(default)/documents/users/$(personnelId))
        && firestore.get(/databases/(default)/documents/users/$(personnelId)).data.schoolId == schoolId
        && firestore.get(/databases/(default)/documents/users/$(personnelId)).data.role == "teacher";
    }

    match /school-calendars/{schoolId}/{schoolYearId}/{fileName} {
      function calendarSourcePath() {
        return "school-calendars/" + schoolId + "/" + schoolYearId + "/" + fileName;
      }
      function ownsCalendar() {
        return signedIn()
          && role() == "study_director"
          && tenantSchoolId() == schoolId
          && firestore.exists(/databases/(default)/documents/schoolYears/$(schoolYearId))
          && firestore.get(/databases/(default)/documents/schoolYears/$(schoolYearId)).data.schoolId == schoolId;
      }
      allow get: if ownsCalendar();
      allow list: if false;
      allow create: if resource == null
        && ownsCalendar()
        && schoolAcceptsWrites(schoolId)
        && firestore.get(/databases/(default)/documents/schools/$(schoolId)).data.activeSchoolYearId == schoolYearId
        && fileName.matches('^[0-9a-fA-F-]{36}\\.pdf$')
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == "application/pdf"
        && request.resource.metadata.keys().hasAll(["schoolId", "schoolYearId", "uploadedBy", "originalName"])
        && request.resource.metadata.schoolId == schoolId
        && request.resource.metadata.schoolYearId == schoolYearId
        && request.resource.metadata.uploadedBy == request.auth.uid
        && request.resource.metadata.originalName is string
        && request.resource.metadata.originalName.size() > 0
        && request.resource.metadata.originalName.size() <= 120;
      allow update: if false;
      allow delete: if ownsCalendar()
        && resource.metadata.uploadedBy == request.auth.uid
        && (!firestore.exists(/databases/(default)/documents/schoolCalendars/$(schoolYearId))
          || !firestore.get(/databases/(default)/documents/schoolCalendars/$(schoolYearId)).data.keys().hasAny(["sourcePdf"])
          || firestore.get(/databases/(default)/documents/schoolCalendars/$(schoolYearId)).data.sourcePdf.path != calendarSourcePath());
    }

    match /personnel-photos/{schoolId}/{personnelId}/{fileName} {
      allow read: if (signedIn() && role() == "super_admin") || (schoolAcceptsWrites(schoolId) && ((signedIn() && role() == "school_admin" && tenantSchoolId() == schoolId) || studyDirectorManagesTeacher(schoolId, personnelId)));
      allow create: if ((signedIn() && role() == "school_admin" && tenantSchoolId() == schoolId) || studyDirectorManagesTeacher(schoolId, personnelId)) && schoolAcceptsWrites(schoolId) && validPersonnelPhoto(fileName, schoolId, personnelId);
      allow update: if false;
      allow delete: if schoolAcceptsWrites(schoolId) && ((signedIn() && role() == "school_admin" && tenantSchoolId() == schoolId) || studyDirectorManagesTeacher(schoolId, personnelId));
    }

    function validValveAttachment(fileName, schoolId, schoolYearId, publicationId) {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.metadata.schoolId == schoolId
        && request.resource.metadata.schoolYearId == schoolYearId
        && request.resource.metadata.publicationId == publicationId
        && request.resource.metadata.originalName is string
        && request.resource.metadata.originalName.size() > 0
        && request.resource.metadata.originalName.size() <= 120
        && (
          (request.resource.contentType == "application/pdf" && fileName.matches('^[0-9a-fA-F-]{36}\\.pdf$'))
          || (request.resource.contentType == "image/jpeg" && fileName.matches('^[0-9a-fA-F-]{36}\\.(jpg|jpeg)$'))
          || (request.resource.contentType == "image/png" && fileName.matches('^[0-9a-fA-F-]{36}\\.png$'))
          || (request.resource.contentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document" && fileName.matches('^[0-9a-fA-F-]{36}\\.docx$'))
        );
    }

    match /valves/{schoolId}/{schoolYearId}/{publicationId}/{fileName} {
      allow read: if signedIn() && tenantSchoolId() == schoolId && schoolAcceptsWrites(schoolId);
      allow create, update: if signedIn()
        && valvesRole()
        && tenantSchoolId() == schoolId
        && schoolAcceptsWrites(schoolId)
        && validValveAttachment(fileName, schoolId, schoolYearId, publicationId);
      allow delete: if signedIn()
        && valvesRole()
        && tenantSchoolId() == schoolId
        && schoolAcceptsWrites(schoolId);
    }

    match /schools/{schoolId}/correspondences/{correspondenceId}/{fileName} {
      // Le profil, l'école et le courrier sont trois sources indépendantes.
      // Storage Rules ne peut en consulter que deux par requête : les accès
      // passent donc par la fonction authentifiée secretaryCorrespondenceFile.
      allow read, write: if false;
    }

    match /message-uploads/{schoolId}/{senderId}/{draftId}/{fileName} {
      allow read: if false;
      allow create: if signedIn()
        && role() == "secretary"
        && request.auth.uid == senderId
        && tenantSchoolId() == schoolId
        && schoolAcceptsWrites(schoolId)
        && request.resource.metadata.senderId == senderId
        && request.resource.metadata.draftId == draftId
        && validMessageObject(fileName, schoolId, request.resource.metadata.schoolYearId);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == senderId && tenantSchoolId() == schoolId && schoolAcceptsWrites(schoolId);
    }

    match /messages/{schoolId}/{conversationId}/{messageId}/{fileName} {
      // Profil, école et message sont trois sources indépendantes : la limite
      // de deux consultations Firestore par évaluation Storage impose un
      // téléchargement via la fonction authentifiée messageAttachmentFile.
      allow read: if false;
      allow write: if false;
    }

    match /teacher-documents/{schoolId}/{schoolYearId}/{ownerId}/{teacherId}/{assignmentId}/{documentId}/{fileName} {
      function ownsActiveAssignment() {
        return firestore.exists(/databases/(default)/documents/schools/$(schoolId))
          && firestore.get(/databases/(default)/documents/schools/$(schoolId)).data.get("status", null) == "active"
          && firestore.get(/databases/(default)/documents/schools/$(schoolId)).data.get("activeSchoolYearId", null) == schoolYearId
          && firestore.exists(/databases/(default)/documents/users/$(ownerId))
          && firestore.get(/databases/(default)/documents/users/$(ownerId)).data.schoolId == schoolId
          && firestore.get(/databases/(default)/documents/users/$(ownerId)).data.role == "teacher"
          && firestore.get(/databases/(default)/documents/users/$(ownerId)).data.get("status", null) == "active"
          && firestore.get(/databases/(default)/documents/users/$(ownerId)).data.active == true
          && firestore.get(/databases/(default)/documents/users/$(ownerId)).data.get("storageAssignmentKeys", []) is list
          && schoolId + "/" + schoolYearId + "/" + teacherId + "/" + assignmentId in firestore.get(/databases/(default)/documents/users/$(ownerId)).data.get("storageAssignmentKeys", []);
      }
      function ownActiveTeacher() {
        return signedIn()
          && role() == "teacher"
          && request.auth.uid == ownerId
          && tenantSchoolId() == schoolId
          && ownsActiveAssignment();
      }
      function validPedagogicalFile() {
        return request.resource.size > 0
          && request.resource.size <= 10 * 1024 * 1024
          && request.resource.metadata.schoolId == schoolId
          && request.resource.metadata.schoolYearId == schoolYearId
          && request.resource.metadata.ownerId == ownerId
          && request.resource.metadata.teacherId == teacherId
          && request.resource.metadata.assignmentId == assignmentId
          && request.resource.metadata.documentId == documentId
          && request.resource.metadata.originalName is string
          && request.resource.metadata.originalName.size() > 0
          && request.resource.metadata.originalName.size() <= 120
          && request.resource.contentType in ["application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.ms-powerpoint", "application/vnd.openxmlformats-officedocument.presentationml.presentation", "image/jpeg", "image/png"];
      }
      allow read: if ownActiveTeacher();
      allow create: if ownActiveTeacher() && validPedagogicalFile();
      allow update, delete: if false;
    }
  }
}
