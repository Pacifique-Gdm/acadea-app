rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function tenantSchoolId() {
      return request.auth.token.schoolId;
    }

    function valvesRole() {
      return role() in ["school_admin", "admin", "secretary"];
    }

    function validPersonnelPhoto(fileName, schoolId, personnelId) {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.metadata.schoolId == schoolId
        && request.resource.metadata.personnelId == personnelId
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp"]
        && fileName.matches('^[0-9a-fA-F-]{36}\\.(jpg|png|webp)$');
    }

    function validMessageObject(fileName, schoolId, schoolYearId) {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.metadata.schoolId == schoolId
        && request.resource.metadata.schoolYearId == schoolYearId
        && request.resource.metadata.originalName is string
        && request.resource.metadata.originalName.size() > 0
        && request.resource.metadata.originalName.size() <= 120
        && (
          (request.resource.contentType == "application/pdf" && fileName.matches('^[0-9a-fA-F-]{36}\\.pdf$'))
          || (request.resource.contentType == "image/jpeg" && fileName.matches('^[0-9a-fA-F-]{36}\\.(jpg|jpeg)$'))
          || (request.resource.contentType == "image/png" && fileName.matches('^[0-9a-fA-F-]{36}\\.png$'))
          || (request.resource.contentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document" && fileName.matches('^[0-9a-fA-F-]{36}\\.docx$'))
        );
    }

    function schoolAcceptsWrites(schoolId) {
      return firestore.exists(/databases/(default)/documents/schools/$(schoolId))
        && firestore.get(/databases/(default)/documents/schools/$(schoolId)).data.status != "deleting";
    }

    match /personnel-photos/{schoolId}/{personnelId}/{fileName} {
      allow read: if signedIn() && role() in ["school_admin", "super_admin"] && (role() == "super_admin" || tenantSchoolId() == schoolId);
      allow create: if signedIn() && role() == "school_admin" && tenantSchoolId() == schoolId && schoolAcceptsWrites(schoolId) && validPersonnelPhoto(fileName, schoolId, personnelId);
      allow update: if false;
      allow delete: if signedIn() && role() == "school_admin" && tenantSchoolId() == schoolId;
    }

    function validValveAttachment(fileName, schoolId, schoolYearId, publicationId) {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.metadata.schoolId == schoolId
        && request.resource.metadata.schoolYearId == schoolYearId
        && request.resource.metadata.publicationId == publicationId
        && request.resource.metadata.originalName is string
        && request.resource.metadata.originalName.size() > 0
        && request.resource.metadata.originalName.size() <= 120
        && (
          (request.resource.contentType == "application/pdf" && fileName.matches('^[0-9a-fA-F-]{36}\\.pdf$'))
          || (request.resource.contentType == "image/jpeg" && fileName.matches('^[0-9a-fA-F-]{36}\\.(jpg|jpeg)$'))
          || (request.resource.contentType == "image/png" && fileName.matches('^[0-9a-fA-F-]{36}\\.png$'))
          || (request.resource.contentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document" && fileName.matches('^[0-9a-fA-F-]{36}\\.docx$'))
        );
    }

    match /valves/{schoolId}/{schoolYearId}/{publicationId}/{fileName} {
      allow read: if signedIn() && tenantSchoolId() == schoolId;
      allow create, update: if signedIn()
        && valvesRole()
        && tenantSchoolId() == schoolId
        && schoolAcceptsWrites(schoolId)
        && validValveAttachment(fileName, schoolId, schoolYearId, publicationId);
      allow delete: if signedIn()
        && valvesRole()
        && tenantSchoolId() == schoolId;
    }

    match /schools/{schoolId}/correspondences/{correspondenceId}/{fileName} {
      function correspondence() {
        return firestore.get(/databases/(default)/documents/correspondences/$(correspondenceId)).data;
      }

      allow read: if signedIn()
        && tenantSchoolId() == schoolId
        && correspondence().schoolId == schoolId;
      allow create, update: if signedIn()
        && role() == "secretary"
        && tenantSchoolId() == schoolId
        && schoolAcceptsWrites(schoolId)
        && correspondence().schoolId == schoolId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          "application/pdf",
          "application/msword",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "image/jpeg",
          "image/png"
        ]
        && fileName.matches('.*\\.(pdf|doc|docx|jpg|jpeg|png)$');
      allow delete: if signedIn()
        && role() == "secretary"
        && tenantSchoolId() == schoolId
        && correspondence().schoolId == schoolId;
    }

    match /message-uploads/{schoolId}/{senderId}/{draftId}/{fileName} {
      allow read: if false;
      allow create: if signedIn()
        && role() == "secretary"
        && request.auth.uid == senderId
        && tenantSchoolId() == schoolId
        && schoolAcceptsWrites(schoolId)
        && request.resource.metadata.senderId == senderId
        && request.resource.metadata.draftId == draftId
        && validMessageObject(fileName, schoolId, request.resource.metadata.schoolYearId);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == senderId && tenantSchoolId() == schoolId;
    }

    match /messages/{schoolId}/{conversationId}/{messageId}/{fileName} {
      function message() {
        return firestore.get(/databases/(default)/documents/messages/$(messageId)).data;
      }
      allow read: if signedIn()
        && tenantSchoolId() == schoolId
        && message().schoolId == schoolId
        && message().conversationId == conversationId
        && message().participantIds is list
        && request.auth.uid in message().participantIds;
      allow write: if false;
    }

    match /teacher-documents/{schoolId}/{schoolYearId}/{ownerId}/{teacherId}/{assignmentId}/{documentId}/{fileName} {
      function ownsActiveAssignment() {
        return firestore.exists(/databases/(default)/documents/teachers/$(teacherId))
          && firestore.get(/databases/(default)/documents/teachers/$(teacherId)).data.userId == ownerId
          && firestore.get(/databases/(default)/documents/teachers/$(teacherId)).data.schoolId == schoolId
          && firestore.get(/databases/(default)/documents/teachers/$(teacherId)).data.schoolYearId == schoolYearId
          && firestore.get(/databases/(default)/documents/teachers/$(teacherId)).data.status == "active"
          && firestore.exists(/databases/(default)/documents/pedagogicalAssignments/$(assignmentId))
          && firestore.get(/databases/(default)/documents/pedagogicalAssignments/$(assignmentId)).data.teacherId == teacherId
          && firestore.get(/databases/(default)/documents/pedagogicalAssignments/$(assignmentId)).data.schoolId == schoolId
          && firestore.get(/databases/(default)/documents/pedagogicalAssignments/$(assignmentId)).data.schoolYearId == schoolYearId
          && firestore.get(/databases/(default)/documents/pedagogicalAssignments/$(assignmentId)).data.active == true;
      }
      function ownActiveTeacher() {
        return signedIn()
          && role() == "teacher"
          && request.auth.uid == ownerId
          && tenantSchoolId() == schoolId
          && schoolAcceptsWrites(schoolId)
          && ownsActiveAssignment();
      }
      function validPedagogicalFile() {
        return request.resource.size > 0
          && request.resource.size <= 10 * 1024 * 1024
          && request.resource.metadata.schoolId == schoolId
          && request.resource.metadata.schoolYearId == schoolYearId
          && request.resource.metadata.ownerId == ownerId
          && request.resource.metadata.teacherId == teacherId
          && request.resource.metadata.assignmentId == assignmentId
          && request.resource.metadata.documentId == documentId
          && request.resource.metadata.originalName is string
          && request.resource.metadata.originalName.size() > 0
          && request.resource.metadata.originalName.size() <= 120
          && request.resource.contentType in ["application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.ms-powerpoint", "application/vnd.openxmlformats-officedocument.presentationml.presentation", "image/jpeg", "image/png"];
      }
      allow read: if ownActiveTeacher();
      allow create: if ownActiveTeacher() && validPedagogicalFile();
      allow update, delete: if false;
    }
  }
}
